{
    "key": "group_tb_site_options",
    "title": "Site content — global settings",
    "fields": [
        {
            "key": "field_tb_tab_global",
            "label": "Global",
            "name": "",
            "type": "tab",
            "placement": "top",
            "endpoint": 0
        },
        {
            "key": "field_tb_telegram_url",
            "label": "Telegram community — URL",
            "name": "tb_telegram_url",
            "type": "url",
            "instructions": "Used in all Telegram buttons and links across the site.",
            "required": 0,
            "default_value": "https:\/\/t.me\/taxibaza_sk"
        },
        {
            "key": "field_tb_contact_email",
            "label": "Support email",
            "name": "tb_contact_email",
            "type": "email",
            "instructions": "Displayed on the Contact page.",
            "required": 0,
            "default_value": "support@taxibaza.sk"
        },
        {
            "key": "field_tb_tab_header",
            "label": "Header \/ Menu",
            "name": "",
            "type": "tab",
            "placement": "top",
            "endpoint": 0
        },
        {
            "key": "field_tb_logo_text",
            "label": "Logo (text)",
            "name": "tb_logo_text",
            "type": "text",
            "instructions": "The last dot is highlighted in accent color automatically (e.g. TaxiBaza.sk).",
            "required": 0,
            "default_value": "TaxiBaza.sk"
        },
        {
            "key": "field_tb_logo_image",
            "label": "Logo (image, optional)",
            "name": "tb_logo_image",
            "type": "image",
            "instructions": "If uploaded — replaces the text logo in the header and mobile menu.",
            "required": 0,
            "return_format": "array",
            "preview_size": "medium",
            "library": "all",
            "mime_types": "svg,png,jpg,jpeg,webp"
        },
        {
            "key": "field_tb_header_menu",
            "label": "Navigation menu (desktop + mobile)",
            "name": "tb_header_menu",
            "type": "repeater",
            "instructions": "Shared menu for desktop header and mobile. If empty — the default theme menu is shown.",
            "required": 0,
            "layout": "block",
            "button_label": "Add menu item",
            "sub_fields": [
                {
                    "key": "field_tb_menu_label",
                    "label": "Label",
                    "name": "label",
                    "type": "text",
                    "required": 1,
                    "wrapper": { "width": "30", "class": "", "id": "" }
                },
                {
                    "key": "field_tb_menu_url",
                    "label": "URL",
                    "name": "url",
                    "type": "text",
                    "instructions": "Relative path (\/avto\/, \/blog\/) or full URL. Not needed for dropdown menus.",
                    "required": 0,
                    "wrapper": { "width": "40", "class": "", "id": "" }
                },
                {
                    "key": "field_tb_menu_submenu_type",
                    "label": "Dropdown type",
                    "name": "submenu_type",
                    "type": "select",
                    "choices": {
                        "none": "None (plain link)",
                        "cities": "Cities list (auto)",
                        "custom": "Custom list (below)"
                    },
                    "default_value": "none",
                    "return_format": "value",
                    "allow_null": 0,
                    "multiple": 0,
                    "ui": 0,
                    "ajax": 0,
                    "wrapper": { "width": "30", "class": "", "id": "" }
                },
                {
                    "key": "field_tb_menu_submenu",
                    "label": "Dropdown items",
                    "name": "submenu",
                    "type": "repeater",
                    "instructions": "",
                    "required": 0,
                    "conditional_logic": [
                        [
                            {
                                "field": "field_tb_menu_submenu_type",
                                "operator": "==",
                                "value": "custom"
                            }
                        ]
                    ],
                    "layout": "table",
                    "button_label": "Add sub-item",
                    "sub_fields": [
                        {
                            "key": "field_tb_submenu_label",
                            "label": "Label",
                            "name": "label",
                            "type": "text",
                            "required": 1
                        },
                        {
                            "key": "field_tb_submenu_url",
                            "label": "URL",
                            "name": "url",
                            "type": "text",
                            "required": 1
                        }
                    ]
                }
            ]
        },
        {
            "key": "field_tb_login_label",
            "label": "Sign in — button",
